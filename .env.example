# Set to 1 to persist session config (base_url, model, api_key) to sessions.json
# across server restarts. Set to 0 to keep sessions in-memory only (lost on restart).
PERSIST_SESSIONS=0

# Directory for conversation persistence. Conversations are stored as JSON files
# under DATA_DIR/<session-id>/conversations/. Leave empty or unset to disable
# conversation persistence (ephemeral mode, backward compatible).
DATA_DIR=data